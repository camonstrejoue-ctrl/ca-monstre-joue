rules_version = '2';

// À coller dans la console Firebase : Storage > Règles.
service firebase.storage {
  match /b/{bucket}/o {
    // Photo de profil : lisible par tout utilisateur connecté (l'app ne
    // l'affiche que si le propriétaire a autorisé "photo" dans visibility),
    // modifiable uniquement par son propriétaire.
    match /profile-photos/{uid}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
