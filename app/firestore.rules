rules_version = '2';

// À coller dans la console Firebase : Firestore Database > Règles.
// Le contenu éditorial (jeux/articles/catégories) n'est jamais stocké ici :
// il vient de data/content.json, publié avec le site (voir app/src/lib/content.ts).
service cloud.firestore {
  match /databases/{database}/documents {

    // `visibleToPlayers` ne peut être activé (true) que si `birthdate`
    // (Timestamp) correspond à 18 ans ou plus — reflète côté base de données
    // la règle déjà appliquée côté app (voir MIN_CONTACT_AGE et computeAge
    // dans app/src/lib/moderation.ts), pour qu'un client modifié ne puisse
    // pas se rendre visible sans être réellement majeur. Approximation par
    // millisecondes (365.25 j/an, comme une année moyenne avec bissextiles) :
    // à quelques heures près autour de l'anniversaire exact, ce qui est
    // largement suffisant pour ce garde-fou.
    function isValidVisibility(data) {
      return data.visibleToPlayers != true
        || (data.birthdate is timestamp
          && data.birthdate.toMillis() <= request.time.toMillis() - 18 * 365.25 * 24 * 60 * 60 * 1000);
    }

    // Profil + ludothèque : un utilisateur connecté peut toujours lire son
    // propre profil, et peut lire celui d'un autre uniquement si celui-ci a
    // explicitement activé `visibleToPlayers` (voir "Trouver des joueurs"
    // dans Profil). Avant ce correctif, n'importe quel compte connecté
    // pouvait lire TOUS les profils bruts (email de contact, âge, ville...)
    // en interrogeant Firestore directement, même ceux qui avaient
    // explicitement décoché "être visible" — le filtre n'existait que côté
    // app. Modifiable uniquement par son propriétaire, et seulement si le
    // document résultant respecte la règle d'âge minimum (voir plus bas).
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || resource.data.visibleToPlayers == true);
      // `request.resource` est null pour une suppression : séparé de
      // create/update, qui sont les seuls cas où isValidVisibility doit
      // s'appliquer (sinon la suppression de compte serait toujours
      // refusée par cette règle).
      allow create, update: if request.auth != null && request.auth.uid == userId
        && isValidVisibility(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Lisible dans les mêmes conditions que le profil parent : soi-même,
      // ou un profil que son propriétaire a rendu visible (pour afficher sa
      // ludothèque publique depuis sa fiche joueur).
      match /ludotheque/{gameSlug} {
        allow read: if request.auth != null
          && (request.auth.uid == userId
            || get(/databases/$(database)/documents/users/$(userId)).data.visibleToPlayers == true);
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Agenda : événements publics (festivals, tournois en boutique, soirées
    // jeux entre particuliers, etc.), lisibles par tout le monde, y compris
    // sans compte. Création réservée aux connectés, modification/suppression
    // réservées à l'auteur.
    match /events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    // Signalements : n'importe quel utilisateur connecté peut en créer un,
    // mais personne ne peut les lire, modifier ou supprimer depuis l'app
    // (consultation manuelle par l'admin depuis la console Firebase).
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Suggestions de fonctionnalités : même principe que les signalements,
    // consultation manuelle depuis la console Firebase.
    match /suggestions/{suggestionId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
