# Copie ce fichier en .env.local (ignoré par git) et remplis les valeurs
# depuis la console Firebase : Paramètres du projet > Général > Tes applications
# > application Web > SDK setup and configuration > Config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optionnel : pour tester en local contre `serve.ps1` au lieu du site en ligne.
# EXPO_PUBLIC_SITE_BASE_URL=http://localhost:8752
